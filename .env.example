# Copy to .env and fill in. Never commit .env.
# 64 hex chars: openssl rand -hex 32 (same value for server and worker)
DOIT_ENCRYPTION_KEY=
# Optional fallback when credentials are not set in the Admin
DOIT_API_KEY=
DOIT_WEBHOOK_SECRET=
# Integration tests only (sandbox key, pb_test_...)
DOIT_TEST_API_KEY=
